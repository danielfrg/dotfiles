# Track the Claude Code alias despite a user-level `.claude` ignore rule.
!home/.claude/
home/.claude/*
!home/.claude/CLAUDE.md

home/.config/karabiner/assets
home/.config/karabiner/automatic_backups

home/.ipython/profile_default/history.sqlite
home/.ipython/profile_default/db/
!home/.ipython/profile_default/ipython_config.py

home/.jupyter/lab/
home/.jupyter/serverconfig/
home/.jupyter/migrated
home/.jupyter/lab/workspaces/

home/.config/nvim/lua/local.lua
home/.config/nvim/lazy-lock.json

home/.gnupg/crls.d/

