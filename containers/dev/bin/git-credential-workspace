#!/usr/bin/env python3
"""Git credential protocol: route current mounted tokens by HTTPS host/owner."""
import json
import os
from pathlib import Path
import re
import sys


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {"get", "store", "erase"}:
        return 1
    if sys.argv[1] != "get":
        return 0
    fields = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        key, separator, value = line.partition("=")
        if not separator or key in fields or "\r" in value:
            return 0
        fields[key] = value
    host, path = fields.get("host", "").lower(), fields.get("path", "")
    if fields.get("protocol") != "https" or any(p in {".", ".."} for p in path.split("/")):
        return 0
    mapping = Path(os.environ.get("DEV_CREDENTIAL_MAP", "/etc/dev/credential-map.json"))
    if not mapping.is_file():
        return 0
    entries = json.loads(mapping.read_text())
    for entry in sorted(entries, key=lambda e: len(e["path_prefix"]), reverse=True):
        prefix = entry["path_prefix"]
        matches = path.startswith(prefix) if prefix.endswith("/") else path == prefix
        if host != entry["host"].lower() or not matches:
            continue
        filename, username = entry["token_file"], entry["username"]
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", filename) or any(c in username for c in "\r\n"):
            raise ValueError("invalid mapping")
        directory = Path(os.environ.get("DEV_GIT_SECRET_DIR", "/run/secrets/opencode-git"))
        file = directory / filename
        if not file.resolve().is_relative_to(directory.resolve()):
            raise ValueError("token outside mounted directory")
        token = file.read_text().strip()
        if not token or any(c in token for c in "\r\n"):
            raise ValueError("invalid token")
        # This stdout is Git's private credential protocol, never a shell/log command.
        sys.stdout.write(f"username={username}\npassword={token}\n\n")
        return 0
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        print("Workspace credential is unavailable or invalid.", file=sys.stderr)
        sys.exit(1)
