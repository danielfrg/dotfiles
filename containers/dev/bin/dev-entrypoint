#!/usr/bin/env python3
"""Persistent personal workspace lifecycle; never migrate the database implicitly."""
import base64
from contextlib import closing
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.request


class WorkspacePolicyError(Exception):
    """Only fixed, nonsecret messages are used for this exception."""


def paths():
    home = Path(os.environ["HOME"])
    database = home / ".local/share/opencode/opencode.db"
    if os.environ.get("OPENCODE_DB", str(database)) != str(database):
        raise RuntimeError("OPENCODE_DB must remain on the persistent home volume")
    return home, database


def validate_service_config(home, database):
    file = home / ".config/opencode/service.json"
    config = json.loads(file.read_text()) if file.exists() else {}
    if not isinstance(config, dict) or not isinstance(config.get("env", {}), dict):
        raise WorkspacePolicyError("Refusing invalid persisted service configuration.")
    if config.get("remote") is not None and config["remote"] is not False:
        raise WorkspacePolicyError("Refusing retained remote access; disable it explicitly before launch.")
    protected = {
        "HOME": str(home), "OPENCODE_DB": str(database),
        "XDG_CONFIG_HOME": str(home / ".config"),
        "XDG_DATA_HOME": str(home / ".local/share"),
        "XDG_STATE_HOME": str(home / ".local/state"),
        "XDG_CACHE_HOME": str(home / ".cache"),
        "OPENCODE_CONFIG_DIR": str(home / ".config/opencode"),
    }
    for environment in [os.environ, config.get("env", {})]:
        if any(key in environment and environment[key] != value for key, value in protected.items()):
            raise WorkspacePolicyError("Refusing environment overrides that move persistent workspace paths.")


def copy_missing(source, destination):
    if destination.exists() or destination.is_symlink():
        return
    with destination.open("x") as output:
        output.write(source.read_text())


def bootstrap():
    home, database = paths()
    validate_service_config(home, database)
    profile = Path(os.environ.get("DEV_PROFILE_DIR", "/opt/dev/profile"))
    for relative in [".config/opencode", ".local/state/opencode", ".local/share/opencode", ".local/bin", ".cache", ".kube"]:
        (home / relative).mkdir(parents=True, exist_ok=True)
    for owner in ["danielfrg", "inmatura", "nvidia"]:
        (home / "code" / owner).mkdir(parents=True, exist_ok=True)
    for source, destination in [(".zshrc", ".zshrc"), ("starship.toml", ".config/starship.toml"), ("AGENTS.md", ".config/opencode/AGENTS.md")]:
        copy_missing(profile / source, home / destination)
    configs = [home / ".config/opencode" / name for name in ["opencode.json", "opencode.jsonc"]]
    if not any(file.exists() or file.is_symlink() for file in configs):
        copy_missing(profile / "opencode.json", configs[0])
    gitconfig = home / ".gitconfig"
    git_env = {**os.environ, "HOME": str(home), "XDG_CONFIG_HOME": str(home / ".config"), "GIT_CONFIG_NOSYSTEM": "1"}
    for variable in list(git_env):
        if variable in {"GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_COUNT"} or variable.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")):
            git_env.pop(variable)
    defaults = [("user.name", "Daniel Rodriguez"), ("user.email", "daniel@danielfrg.com"), ("credential.helper", "/usr/local/bin/git-credential-workspace"), ("credential.useHttpPath", "true")]
    configured, conditional = set(), False
    # Inspect both user scopes before writing: --global alone selects one file.
    for config_file in [home / ".config/git/config", gitconfig]:
        if not config_file.exists():
            continue
        base = ["git", "-C", str(home), "config", "--file", str(config_file), "--includes"]
        includes = subprocess.run([*base, "--get-regexp", r"^includeif\..*\.path$"], env=git_env, capture_output=True)
        if includes.returncode not in {0, 1}:
            raise RuntimeError("Invalid existing Git configuration")
        conditional |= includes.returncode == 0
        for key, _ in defaults:
            existing = subprocess.run([*base, "--get", key], env=git_env, capture_output=True)
            if existing.returncode == 0:
                configured.add(key)
            elif existing.returncode != 1:
                raise RuntimeError("Invalid existing Git configuration")
    for key, value in defaults:
        if key not in configured and not conditional:
            subprocess.run(["git", "config", "--file", str(gitconfig), key, value], env=git_env, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.environ["OPENCODE_DB"] = str(database)
    service_account = Path("/var/run/secrets/kubernetes.io/serviceaccount")
    if (service_account / "token").is_file():
        kubeconfig = home / ".kube/homelab"
        if not kubeconfig.exists():
            kubeconfig.write_text(json.dumps({
                "apiVersion": "v1", "kind": "Config",
                "clusters": [{"name": "homelab", "cluster": {"server": "https://kubernetes.default.svc", "certificate-authority": str(service_account / "ca.crt")}}],
                "users": [{"name": "opencode", "user": {"tokenFile": str(service_account / "token")}}],
                "contexts": [{"name": "homelab", "context": {"cluster": "homelab", "user": "opencode", "namespace": "opencode"}}],
                "current-context": "homelab",
            }, indent=2) + "\n")
        os.environ["KUBECONFIG"] = str(kubeconfig)


def serve():
    bootstrap()
    home, _ = paths()
    # Held across exec: a second invocation cannot stop/replace the first service.
    lock = os.open(home / ".local/state/opencode/workspace.lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise RuntimeError("Another workspace server already holds this home") from None
    os.set_inheritable(lock, True)
    secrets = Path(os.environ.get("DEV_RUNTIME_SECRET_DIR", "/run/secrets/opencode-runtime"))
    password = (secrets / "server-password").read_text().strip()
    if not password:
        raise RuntimeError("A nonempty server-password is required")
    registration = home / ".local/state/opencode/service.json"
    if registration.exists() or registration.is_symlink():
        # The NAS lock is held. PID-bearing registration may belong to a dead
        # container; never let stop-capable service configuration act on that PID.
        try:
            health()
        except (OSError, ValueError, KeyError) as error:
            if hasattr(error, "close"):
                error.close()
        else:
            raise WorkspacePolicyError("An OpenCode server is already running; attach instead of replacing it.")
        registration.unlink()
    for key, value in [("hostname", "0.0.0.0"), ("port", "4096"), ("password", password)]:
        result = subprocess.run(["opencode", "service", "set", key, value], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        if result.returncode:
            raise RuntimeError("OpenCode service configuration failed")
    for filename, variable in [("argocd-token", "ARGOCD_AUTH_TOKEN"), ("anthropic-api-key", "ANTHROPIC_API_KEY"), ("openai-api-key", "OPENAI_API_KEY")]:
        file = secrets / filename
        if file.is_file() and file.read_text().strip():
            os.environ[variable] = file.read_text().strip()
    os.execvp("opencode", ["opencode", "serve", "--service", "--hostname", "0.0.0.0", "--port", "4096"])


def health():
    home, _ = paths()
    registration = json.loads((home / ".local/state/opencode/service.json").read_text())
    password = registration["password"]
    header = "Basic " + base64.b64encode(("opencode:" + password).encode()).decode()
    request = urllib.request.Request("http://127.0.0.1:4096/api/info", headers={"Authorization": header})
    # Do not use opencode api here: its normal discovery can start a missing service.
    with urllib.request.urlopen(request, timeout=3) as response:
        json.load(response)


def backup():
    _, database = paths()
    if not database.is_file():
        raise RuntimeError("No existing OpenCode database to back up")
    directory = database.parent / "backups"
    directory.mkdir(mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".pending-", dir=directory)
    os.close(descriptor)
    pending = Path(temporary)
    deadline = time.monotonic() + 30
    def progress(status, remaining, total):
        if time.monotonic() > deadline:
            raise RuntimeError("Database backup timed out; previous backups are unchanged")
    try:
        with closing(sqlite3.connect(database.absolute().as_uri() + "?mode=ro", uri=True, timeout=5)) as source:
            with closing(sqlite3.connect(pending)) as destination:
                source.backup(destination, pages=100, progress=progress)
                if destination.execute("PRAGMA integrity_check").fetchall() != [("ok",)]:
                    raise RuntimeError("Backup integrity check failed")
        name = "backup-" + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ") + ".sqlite3"
        os.replace(pending, directory / name)
        pattern = re.compile(r"backup-\d{8}T\d{12}Z\.sqlite3")
        completed = sorted(p for p in directory.iterdir() if pattern.fullmatch(p.name) and p.is_file() and not p.is_symlink())
        for old in completed[:-7]:
            old.unlink()
        print(str(directory / name))
    finally:
        pending.unlink(missing_ok=True)


def main():
    os.umask(0o077)
    modes = {"bootstrap": bootstrap, "serve": serve, "health": health, "backup": backup}
    mode = sys.argv[1] if len(sys.argv) == 2 else "serve" if len(sys.argv) == 1 else None
    if mode not in modes:
        raise RuntimeError("Usage: dev-entrypoint [bootstrap|serve|health|backup]")
    modes[mode]()


if __name__ == "__main__":
    try:
        main()
    except WorkspacePolicyError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except Exception:
        # No arguments, token contents, subprocess repr, or tracebacks in logs.
        print("Workspace operation failed; check paths, permissions, credentials, and server state.", file=sys.stderr)
        sys.exit(1)
